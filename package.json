  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.ts",
    "migrate:make": "knex --knexfile knexfile.ts migrate:make -x ts",
